# interlingua conformance vectors: envelopes (wire format 1, suite IL1-CNSA2)
# Regenerate with `il vectors generate spec/vectors`. Keys: keyring.pub and
# test-secrets.txt (published TEST keys).
#
# name       what the record shows
# envelope   the envelope (hex)
# expect     valid, or error:<id> (docs/SPECIFICATION.md section 9 lists the ids)
# payload    the payload after verify + open (valid records)
# recipient  domain whose test key opens a sealed payload
# signer     source domain (its ML-DSA-87 key is in keyring.pub)
# signed     bytes the signature covers: CBOR ["IL1-Sign", protected, payload]
# signature  the ML-DSA-87 signature (pure mode, empty context)
# kem-ct, kem-ss, aead-key, aead-nonce, aead-aad, aead-ct
#            sealing intermediates, so independent ML-KEM, HKDF and AES-GCM
#            implementations can be checked against them

[valid]

name = plaintext
signer = ground-ops
envelope = 
expect = valid
payload = 68656c6c6f2c20776f726c64
signed = 
signature = 

name = plaintext-utf8
signer = ground-ops
envelope = 
expect = valid
payload = ce95cebbcebbceb7cebdceb9cebaceac20c2b720e697a5e69cace8aa9e20c2b720e284b5e2828020c2b720f09f9a80
signed = 
signature = 

name = sealed
signer = ground-ops
envelope = 
expect = valid
payload = 41524d205041594c4f414420424159
recipient = space-segment
signed = 
signature = 
kem-ct = 
kem-ss = 5f082e27638fee6953f0883aa8e37d293ae2ac073f6e41a17c5a4683b3fee3a6
aead-key = b555fe28a730d7c17fb451f1c2f376d301765d5d72ea6d98484befad3285fc1d
aead-nonce = 10ff5878e5f44062456a24d7
aead-aad = 
aead-ct = 0d0ad45c19f46ca9c95f88c71c08265aec20c5703201f8cfa565dad6f3de49

name = empty-public-payload
signer = archive
envelope = 
expect = valid
payload = 
signed = 
signature = 

[refused]

name = tampered-payload
envelope = 
expect = error:BadSignature

name = tampered-signature
envelope = 
expect = error:BadSignature

name = unknown-signer
envelope = 
expect = error:UnknownSigner

name = signer-not-authorized
envelope = 
expect = error:SignerNotAuthorized

name = wrong-recipient
envelope = 
recipient = ground-ops
expect = error:WrongRecipient

name = key-required
envelope = 
expect = error:KeyRequired

name = aead-tag-mismatch
envelope = 
recipient = space-segment
expect = error:Decrypt

[malformed]

name = non-canonical-hop-count
envelope = 
expect = error:Cbor/NonCanonicalInteger

name = unknown-unprotected-field
envelope = 
expect = error:Schema

name = future-version
envelope = 
expect = error:Version

name = not-an-envelope
envelope = a0
expect = error:Schema

name = trailing-bytes
envelope = 
expect = error:Cbor/TrailingBytes
